# =========================================================
# APP
# =========================================================
APP_ENV=local
SERVICE_NAME=baggage-claim-ai
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# =========================================================
# AI PROVIDERS  (POC: all Gemini Flash — free tier)
# https://ai.google.dev/pricing  →  1500 req/day, 1M tokens/day free
# =========================================================
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# Provider switches — swap without touching agent code
LLM_PROVIDER=gemini          # future: claude | openai | ollama
VISION_PROVIDER=gemini       # future: yolov8 | mobilenet
OCR_PROVIDER=gemini          # future: paddleocr
STORAGE_PROVIDER=local       # future: r2 | s3
DB_PROVIDER=supabase         # future: postgres

# =========================================================
# GEMINI MODEL CONFIG
# =========================================================
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
LLM_DEFAULT_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024

# =========================================================
# DATABASE  (POC: Supabase free tier — 500MB, no credit card)
# https://supabase.com/pricing
# =========================================================
SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# =========================================================
# STORAGE  (POC: local disk — zero cost)
# =========================================================
LOCAL_STORAGE_BASE_PATH=./data/uploads
# Future Cloudflare R2 — free up to 10GB
# R2_ACCOUNT_ID=<ACCOUNT_ID>
# R2_ACCESS_KEY_ID=<ACCESS_KEY>
# R2_SECRET_ACCESS_KEY=<SECRET_KEY>
# R2_BUCKET_NAME=baggage-claims

# =========================================================
# AWS — S3 STORAGE  (Production — P-004)
# =========================================================
# Set STORAGE_PROVIDER=s3 to activate. Credentials come from the
# environment's default AWS credential chain (IAM role on ECS task in
# production; `aws configure` / env vars locally) — never hardcode keys here.
S3_BUCKET=abc-baggage-claims-prod
AWS_REGION=us-east-1
S3_PRESIGN_EXPIRY_SECONDS=3600

# =========================================================
# AWS — BEDROCK LLM/VISION/OCR  (Production — P-003)
# =========================================================
# Set LLM_PROVIDER=bedrock / VISION_PROVIDER=bedrock / OCR_PROVIDER=bedrock
# to activate. Reuses AWS_REGION above — no separate Bedrock region setting.
# Requires Bedrock model access for Claude Sonnet 4 to be granted in the
# AWS Console (Console -> Bedrock -> Model Access) before real calls succeed.
BEDROCK_LLM_MODEL=anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_VISION_MODEL=anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_OCR_MODEL=anthropic.claude-sonnet-4-20250514-v1:0

# =========================================================
# CLAIM ROUTING THRESHOLDS
# =========================================================
LANE1_MAX_COMPENSATION_USD=100
FRAUD_PHASH_THRESHOLD=10
CLAIM_ID_PREFIX=CLM

# =========================================================
# DECISION ENGINE
# =========================================================
IMAGEHASH_ENABLED=true
CLAIM_FREQUENCY_WINDOW_DAYS=30
MAX_CLAIMS_PER_PASSENGER=3

QUEUE_PROVIDER=memory
SECRETS_PROVIDER=env
CHANNEL_PROVIDER=webhook
