# =========================================================
# P-012 — Week 1 Integration: AWS Provider Env Reference
# =========================================================
# This file is NOT consumed automatically — it documents the exact
# env var values used to validate the AWS-flipped configuration for
# P-012. Copy the relevant lines into your local .env (or export them
# in your shell) before running `pytest tests/ -v` or the smoke test.
#
# All AWS calls in this configuration are intercepted by moto or
# unittest.mock — nothing here touches real AWS. Do NOT put real
# credentials in this file; it is for local/CI verification only.
#
# Author: Devam — P-012

# =========================================================
# APP
# =========================================================
APP_ENV=local
SERVICE_NAME=baggage-claim-ai
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# Keep simulator OFF for this run — P-012 is validating the
# production-shaped provider wiring, not the dev simulator UI.
ENABLE_SIMULATOR=false
VITE_ENABLE_SIMULATOR=false



# =========================================================
# PROVIDER SWITCHES — ALL FLIPPED TO AWS (per P-012 task spec)
# =========================================================
LLM_PROVIDER=bedrock
VISION_PROVIDER=bedrock
OCR_PROVIDER=bedrock
STORAGE_PROVIDER=s3
QUEUE_PROVIDER=sqs
SECRETS_PROVIDER=aws_sm

# DB_PROVIDER and CHANNEL_PROVIDER are intentionally left at their
# existing values — neither is in scope for P-012's flip list (see
# Task Tracker P-012 description). DB stays supabase until a future
# RDS migration task; channel stays webhook until P-024.
DB_PROVIDER=supabase
CHANNEL_PROVIDER=webhook

# =========================================================
# AWS — REGION
# =========================================================
AWS_REGION=us-east-1

# =========================================================
# AWS — BEDROCK LLM/VISION/OCR (P-003)
# =========================================================
BEDROCK_LLM_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_VISION_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_OCR_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0

# =========================================================
# AWS — S3 STORAGE (P-004)
# =========================================================
S3_BUCKET=abc-baggage-claims-integration
S3_PRESIGN_EXPIRY_SECONDS=3600

# =========================================================
# AWS — SECRETS MANAGER (P-005)
# =========================================================
SECRETS_MANAGER_NAME=baggage-claim/integration

# =========================================================
# AWS — SQS QUEUE (P-006)
# =========================================================
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/claim-jobs-integration
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/000000000000/claim-jobs-dlq-integration
SQS_VISIBILITY_TIMEOUT_SECONDS=60

# =========================================================
# SUPABASE — unchanged, DB_PROVIDER not in scope for P-012
# =========================================================
# Leave your existing dev Supabase values in your real .env.
# Not required for the moto-mocked smoke test (provide_db() degrades
# to None gracefully when unset — see backend/dependencies.py).

# =========================================================
# CLAIM ROUTING / DECISION ENGINE — unchanged from POC defaults
# =========================================================
LANE1_MAX_COMPENSATION_USD=100
FRAUD_PHASH_THRESHOLD=10
CLAIM_ID_PREFIX=CLM
IMAGEHASH_ENABLED=true
CLAIM_FREQUENCY_WINDOW_DAYS=30
MAX_CLAIMS_PER_PASSENGER=3
