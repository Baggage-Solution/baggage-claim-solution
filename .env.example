# =========================================================
# APP
# =========================================================
APP_ENV=local
SERVICE_NAME=baggage-claim-ai
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# =========================================================
# FEATURE FLAGS — P-009
# =========================================================
# Set to true for local dev / simulator usage.
# Leave unset (defaults to false) in production ECS task definitions.
# Backend: controls /uploads static mount + simulator-specific routes.
# Frontend: controls whether /simulator renders or shows disabled page.
ENABLE_SIMULATOR=true
# Frontend Vite env var (must be prefixed VITE_ to be exposed to the browser)
VITE_ENABLE_SIMULATOR=true

# =========================================================
# AI PROVIDERS  (POC: all Gemini Flash — free tier)
# =========================================================
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# Provider switches — swap without touching agent code
LLM_PROVIDER=gemini          # production: bedrock
VISION_PROVIDER=gemini       # production: bedrock
OCR_PROVIDER=gemini          # production: bedrock
STORAGE_PROVIDER=local       # production: s3
DB_PROVIDER=supabase
QUEUE_PROVIDER=memory        # production: sqs
SECRETS_PROVIDER=env         # production: aws_sm
CHANNEL_PROVIDER=webhook     # production: whatsapp

# =========================================================
# GEMINI MODEL CONFIG
# =========================================================
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
LLM_DEFAULT_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024

# =========================================================
# DATABASE  (POC: Supabase free tier)
# =========================================================
SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# =========================================================
# STORAGE  (POC: local disk — zero cost)
# =========================================================
LOCAL_STORAGE_BASE_PATH=./data/uploads

# =========================================================
# AWS — S3 STORAGE  (Production — P-004)
# =========================================================
S3_BUCKET=abc-baggage-claims-prod
AWS_REGION=us-east-1
S3_PRESIGN_EXPIRY_SECONDS=3600

# =========================================================
# AWS — BEDROCK LLM/VISION/OCR  (Production — P-003)
# =========================================================
BEDROCK_LLM_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_VISION_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_OCR_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0

# =========================================================
# AWS — SECRETS MANAGER  (Production — P-005)
# =========================================================
SECRETS_MANAGER_NAME=baggage-claim/prod

# =========================================================
# AWS — SQS QUEUE  (Production — P-006)
# =========================================================
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<ACCOUNT_ID>/baggage-claim-queue-prod
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/<ACCOUNT_ID>/baggage-claim-dlq-prod
SQS_VISIBILITY_TIMEOUT_SECONDS=60

# =========================================================
# CLAIM ROUTING THRESHOLDS
# =========================================================
LANE1_MAX_COMPENSATION_USD=100
FRAUD_PHASH_THRESHOLD=10
CLAIM_ID_PREFIX=CLM

# =========================================================
# DECISION ENGINE
# =========================================================
IMAGEHASH_ENABLED=true
CLAIM_FREQUENCY_WINDOW_DAYS=30
MAX_CLAIMS_PER_PASSENGER=3
